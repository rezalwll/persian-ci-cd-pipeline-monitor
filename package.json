{
  "name": "release-lens",
  "version": "0.1.0",
  "description": "Policy-driven release health analysis for GitHub Actions",
  "type": "module",
  "bin": {
    "release-lens": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "action.yml"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/action.ts --format esm --dts --clean",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "commander": "12.1.0",
    "picocolors": "1.1.1",
    "yaml": "2.8.3",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "brace-expansion": "2.1.4",
    "esbuild": "0.28.1",
    "flatted": "3.4.2",
    "glob": "10.5.0",
    "minimatch": "9.0.7"
  }
}
